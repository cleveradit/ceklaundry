#!/usr/bin/env python3
"""Create local-only configuration without printing secrets or overwriting .env."""
from pathlib import Path
import base64
import secrets

target = Path(__file__).resolve().parent.parent / '.env'
if target.exists():
    raise SystemExit('.env sudah ada; konfigurasi dipertahankan.')
text = target.with_name('.env.example').read_text()
for key, value in {
    'APP_KEY': 'base64:' + base64.b64encode(secrets.token_bytes(32)).decode(),
    'DB_PASSWORD': secrets.token_hex(24),
    'DB_ROOT_PASSWORD': secrets.token_hex(24),
}.items():
    text = text.replace(key + '=\n', key + '=' + value + '\n')
with target.open('x') as file:
    file.write(text)
target.chmod(0o600)
print('.env lokal dibuat; rahasia tidak ditampilkan.')
